
<div class="container mt-4">
  <h1><%= @movie.title %></h1>
<% if @movie.jacket.attached? %>
  <%= image_tag @movie.jacket, style: "width: 200px; border-radius: 8px;" %>
<% end %>

  <p class="text-muted"><%= @movie.genre %></p>
  <p><%= @movie.description %></p>
  <p>Ajouté par : <%= @movie.user.email %></p>

  <%= link_to "Modifier", edit_movie_path(@movie), class: "btn btn-secondary" %>
  <%= link_to "Supprimer", @movie, data: { turbo_method: :delete, turbo_confirm: "Sûre ?" }, class: "btn btn-danger" %>
  <%= link_to "Retour", movies_path, class: "btn btn-outline-secondary" %>
</div>
